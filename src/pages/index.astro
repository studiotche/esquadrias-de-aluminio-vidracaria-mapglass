---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, solutions, projects, trustItems, faqs, testimonials } from "../data/site";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout>
  <a class="skip-link" href="#inicio">Ir para o conteúdo principal</a>

  <!-- Header -->
  <header class="header site-header">
    <div class="container header-container">
      <a href="#inicio" class="logo-link" aria-label="MAP GLASS - Início">
        <img
          src={asset(site.assets.logo)}
          alt="MAP GLASS - Esquadrias de Alumínio & Vidraçaria"
          class="logo"
          width="180"
          height="56"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="main-nav" aria-label="Navegação principal">
        <ul class="nav-list">
          <li><a href="#inicio" class="nav-link active">Início</a></li>
          <li><a href="#solucoes" class="nav-link">Soluções</a></li>
          <li><a href="#projetos" class="nav-link">Projetos</a></li>
          <li><a href="#sobre" class="nav-link">Sobre</a></li>
          <li><a href="#depoimentos" class="nav-link">Depoimentos</a></li>
          <li><a href="#faq" class="nav-link">FAQ</a></li>
          <li><a href="#localizacao" class="nav-link">Localização</a></li>
        </ul>
      </nav>

      <a
        href={site.whatsappUrl}
        class="btn btn-primary header-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar orçamento pelo WhatsApp"
      >
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
        <span>Solicitar orçamento</span>
      </a>

      <button
        class="hamburger"
        id="hamburgerBtn"
        type="button"
        aria-expanded="false"
        aria-controls="mobileMenu"
        aria-label="Abrir menu de navegação"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <!-- Mobile Menu Drawer (Smooth Slide from Right) -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-backdrop" data-close-menu></div>
    <div class="mobile-menu-panel">
      <button
        class="menu-close"
        type="button"
        data-close-menu
        aria-label="Fechar menu"
      >
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="menu-panel-head">
        <img
          src={asset(site.assets.logo)}
          alt="MAP GLASS - Esquadrias de Alumínio & Vidraçaria"
          class="menu-logo"
          width="150"
          height="46"
        />
        <small class="menu-subtitle">Esquadrias & Vidraçaria Sob Medida</small>
      </div>
      <nav class="mobile-nav" aria-label="Navegação móvel">
        <a href="#inicio">Início</a>
        <a href="#solucoes">Soluções</a>
        <a href="#projetos">Projetos</a>
        <a href="#sobre">Sobre</a>
        <a href="#depoimentos">Depoimentos</a>
        <a href="#faq">Dúvidas Frequentes</a>
        <a href="#localizacao">Localização</a>
      </nav>
      <div class="menu-panel-footer">
        <a
          class="btn btn-secondary menu-cta"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span>Solicitar orçamento</span>
        </a>
        <div class="menu-contact-info">
          <p><i class="ph ph-map-pin" aria-hidden="true"></i> Novo Hamburgo / RS</p>
          <p><i class="ph ph-phone" aria-hidden="true"></i> (51) 99540-6595</p>
        </div>
      </div>
    </div>
  </div>

  <main>
    <!-- Hero Section -->
    <section id="inicio" class="hero" aria-labelledby="hero-heading">
      <div class="hero-bg">
        <img
          src={asset(site.assets.hero)}
          alt="Fachada moderna de alto padrão com esquadrias em alumínio e grandes painéis em vidro"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-overlay" aria-hidden="true"></div>
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow hero-animate-up">ESQUADRIAS EM ALUMÍNIO &bull; NOVO HAMBURGO / RS</span>
          <h1 id="hero-heading" class="hero-animate-up hero-delay-80">
            Design que valoriza.<br />Qualidade que<br />permanece.
          </h1>
          <p class="hero-animate-up hero-delay-160">
            Esquadrias sob medida para transformar seu projeto em um lugar especial.
          </p>
          <div class="hero-actions hero-animate-up hero-delay-240">
            <a
              href={site.whatsappUrl}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
              <span>Solicitar meu orçamento</span>
            </a>
            <a href="#solucoes" class="link-with-arrow">
              <span>Conheça nossas soluções</span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
        <div class="hero-caption hero-animate-up hero-delay-320">
          <p>Alumínio, vidro e novas possibilidades.</p>
        </div>
      </div>
    </section>

    <!-- Trust Banner -->
    <section class="trust-banner" aria-label="Diferenciais da MAP GLASS">
      <div class="container trust-container">
        {
          trustItems.map((item, index) => (
            <>
              <div class="trust-item">
                <i class={item.icon} aria-hidden="true"></i>
                <div class="trust-text">
                  <strong>{item.title}</strong>
                  <p>{item.description}</p>
                </div>
              </div>
              {index < trustItems.length - 1 && <div class="trust-divider" aria-hidden="true"></div>}
            </>
          ))
        }
      </div>
    </section>

    <!-- Solutions Section -->
    <section id="solucoes" class="solutions" aria-labelledby="solutions-heading">
      <div class="container">
        <div class="solutions-header">
          <div class="solutions-title-group">
            <span class="eyebrow">NOSSAS SOLUÇÕES</span>
            <h2 id="solutions-heading">
              Cada detalhe faz parte<br />do seu projeto.
            </h2>
          </div>
          <div class="solutions-desc">
            <p>
              Funcionalidade e estética em soluções<br />para diferentes ambientes.
            </p>
          </div>
        </div>

        <div class="solutions-grid">
          {
            solutions.map((item) => (
              <article class="solution-card">
                <div class="solution-image-wrapper">
                  <img
                    src={asset(item.image)}
                    alt={item.alt}
                    class={`solution-image ${item.imgClass}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <h3 class="solution-title">{item.title}</h3>
                <a
                  href={item.link}
                  class="solution-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Saiba mais sobre ${item.title} no WhatsApp`}
                >
                  <span>Saiba mais</span>
                  <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projetos" class="projects" aria-labelledby="projects-heading">
      <div class="container">
        <div class="projects-header">
          <div class="projects-title-group">
            <span class="eyebrow">INSPIRAÇÃO EM CADA ENTREGA</span>
            <h2 id="projects-heading">
              Seu próximo projeto<br />começa com uma boa referência.
            </h2>
          </div>
          <a href="#projetos" class="link-with-arrow projects-link">
            <span>Ver projetos</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="projects-grid">
          {
            projects.map((project) => (
              <button
                class={`project-card ${project.isLarge ? "card-large" : "card-small"}`}
                type="button"
                aria-label={`Ampliar imagem ${project.title}`}
                data-image={asset(project.image)}
                data-caption={project.title}
              >
                <img
                  src={asset(project.image)}
                  alt={project.alt}
                  class="project-image"
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-caption-overlay">
                  <span class="project-caption">{project.title}</span>
                </div>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="sobre" class="about" aria-labelledby="about-heading">
      <div class="container about-container">
        <div class="about-image-wrapper">
          <img
            src={asset(site.assets.about)}
            alt="Equipe de especialistas e fábrica da MAP GLASS em Novo Hamburgo"
            class="about-image"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about-content">
          <span class="eyebrow">SOBRE A MAP GLASS</span>
          <h2 id="about-heading">
            Precisão no detalhe.<br />Cuidado em cada projeto.
          </h2>
          <p>
            A MAP GLASS une qualidade, acabamento refinado e modernidade em soluções sob medida para esquadrias de alumínio e vidros temperados. Atendemos Novo Hamburgo e toda a região do Vale dos Sinos com pontualidade, atendimento consultivo e fabricação própria.
          </p>
          <a
            href={site.instagramUrl}
            class="link-with-arrow about-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Conheça a MAP GLASS no Instagram"
          >
            <span>Conheça a MAP GLASS</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Testimonials Section (Google Reviews - Paridade Nutricionista Nádia) -->
    <section id="depoimentos" class="testimonials-section" aria-labelledby="testimonials-heading">
      <div class="container">
        <div class="testimonial-heading">
          <div>
            <span class="eyebrow">AVALIAÇÕES NO GOOGLE</span>
            <h2 id="testimonials-heading">
              A confiança de quem<br />já transformou seu espaço.
            </h2>
          </div>
          <div class="testimonial-heading-desc">
            <p>
              Relatos reais de clientes sobre o padrão de acabamento, pontualidade e excelência da MAP GLASS.
            </p>
            <a
              class="google-rating"
              href={site.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Avaliação ${site.googleRating.score} de 5 estrelas no Google Maps`}
            >
              <svg class="google-g" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"
                ></path>
              </svg>
              <strong>{site.googleRating.score}</strong>
              <span class="google-stars" aria-hidden="true">
                {
                  [0, 1, 2, 3, 4].map(() => (
                    <svg viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  ))
                }
              </span>
              <small>{site.googleRating.reviews} avaliações no Google</small>
            </a>
          </div>
        </div>

        <div class="testimonial-grid">
          {
            testimonials.map((item) => (
              <figure class="testimonial-card">
                <div class="testimonial-topline">
                  <svg class="google-mark" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"></path>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"></path>
                    <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"></path>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"></path>
                  </svg>
                  <span class="testimonial-stars" role="img" aria-label="5 estrelas">
                    {
                      [0, 1, 2, 3, 4].map(() => (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                        </svg>
                      ))
                    }
                  </span>
                </div>
                <blockquote>"{item.text}"</blockquote>
                <figcaption>
                  <div class="testimonial-author">
                    <strong>{item.name}</strong>
                    <span>{item.city}</span>
                    <a class="testimonial-source" href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer">
                      Avaliação verificada no Google
                    </a>
                  </div>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="faq-section" aria-labelledby="faq-heading">
      <div class="container">
        <div class="faq-grid">
          <div class="faq-header">
            <span class="eyebrow">DÚVIDAS FREQUENTES</span>
            <h2 id="faq-heading">
              Tudo o que você precisa saber antes de iniciar seu projeto.
            </h2>
            <p class="faq-intro">
              Transparência, suporte técnico e segurança para transformar sua residência ou empresa com excelência.
            </p>
            <div class="faq-cta-box">
              <div class="faq-cta-header">
                <div class="faq-cta-icon" aria-hidden="true">
                  <i class="fa-brands fa-whatsapp"></i>
                </div>
                <div class="faq-cta-text">
                  <strong>Ficou com alguma dúvida específica?</strong>
                  <p>Nossa equipe técnica atende você prontamente.</p>
                </div>
              </div>
              <a
                href={site.whatsappUrl}
                class="btn btn-secondary faq-cta-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Falar com especialista</span>
                <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>

          <div class="faq-list">
            {
              faqs.map((faq, index) => (
                <details class="faq-item" open={index === 0}>
                  <summary class="faq-summary">
                    <span class="faq-question-text">{faq.question}</span>
                    <span class="faq-toggle" aria-hidden="true" />
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" aria-labelledby="cta-heading">
      <div class="container cta-container">
        <h2 id="cta-heading" class="cta-title">
          Vamos dar forma<br />ao seu projeto?
        </h2>
        <div class="cta-divider" aria-hidden="true"></div>
        <p class="cta-text">
          Converse com nossa equipe<br />e solicite seu orçamento.
        </p>
        <a
          href={site.whatsappUrl}
          class="btn btn-primary cta-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span>Falar no WhatsApp</span>
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <!-- Location Section (Google Maps Full Width - Paridade Lavanderia Ivoti) -->
    <section class="location-section" id="localizacao" aria-label="Localização da MAP GLASS no Google Maps">
      <iframe
        src={site.mapsEmbedUrl}
        loading="lazy"
        title="Mapa da MAP GLASS no Google Maps"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <!-- Coluna 1: Marca -->
        <div class="footer-brand">
          <img
            src={asset(site.assets.logoWhite)}
            alt="MAP GLASS - Esquadrias de Alumínio & Vidraçaria"
            class="footer-logo"
            loading="lazy"
            decoding="async"
            width="180"
            height="72"
          />
          <p class="footer-desc">
            Esquadrias sob medida e vidraçaria de alto padrão.<br />Qualidade, elegância e modernidade no Vale dos Sinos.
          </p>
          <h3 class="footer-title">ACOMPANHE NOSSOS PROJETOS</h3>
          <div class="footer-social">
            <div class="social-buttons">
              <a
                href={site.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram da MAP GLASS"
                class="social-btn"
              >
                <i class="fa-brands fa-instagram" aria-hidden="true"></i>
              </a>
              <a
                href={site.facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook da MAP GLASS"
                class="social-btn"
              >
                <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
              </a>
            </div>
            <a
              href={site.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="social-handle"
            >
              {site.instagramHandle}
            </a>
          </div>
        </div>

        <!-- Coluna 2: Navegação -->
        <div class="footer-nav">
          <h3 class="footer-title">NAVEGUE</h3>
          <ul class="footer-links">
            <li><a href="#inicio">Início</a></li>
            <li><a href="#solucoes">Soluções</a></li>
            <li><a href="#projetos">Projetos</a></li>
            <li><a href="#sobre">Sobre a MAP GLASS</a></li>
            <li><a href="#depoimentos">Depoimentos</a></li>
            <li><a href="#faq">Dúvidas Frequentes</a></li>
            <li><a href="#localizacao">Localização</a></li>
          </ul>
        </div>

        <!-- Coluna 3: Contato -->
        <div class="footer-contact">
          <h3 class="footer-title">VAMOS CONVERSAR</h3>
          <a
            href={site.whatsappUrl}
            class="footer-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Conversar no WhatsApp ${site.phoneDisplay}`}
          >
            <i class="ph ph-whatsapp-logo" aria-hidden="true"></i>
            <span>{site.phoneDisplay}</span>
          </a>
          <p class="footer-contact-desc">Conte sua ideia para nossa equipe.</p>
          <a
            href={site.whatsappUrl}
            class="btn footer-cta-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Solicitar orçamento</span>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a
            href={site.googleMapsUrl}
            class="footer-location"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver localização da MAP GLASS no Google Maps"
          >
            <i class="ph ph-map-pin" aria-hidden="true"></i>
            <div>
              <span>{site.locationDisplay}</span>
              <small class="footer-address">{site.address}</small>
            </div>
          </a>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; MAP GLASS - Esquadrias de Alumínio & Vidraçaria. Todos os direitos reservados.</p>
        <div class="footer-bottom-links">
          <a href="#" class="privacy-link">Política de privacidade</a>
          <span class="footer-bottom-divider" aria-hidden="true">|</span>
          <a href="#inicio" class="back-to-top">
            <span>Voltar ao topo</span>
            <i class="ph ph-arrow-up" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Modal Lightbox -->
  <dialog id="image-modal" class="image-modal" aria-label="Visualizador de imagem">
    <button class="modal-close" aria-label="Fechar visualizador" type="button" autofocus>
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
    <div class="modal-content">
      <img id="modal-img" src="" alt="Imagem ampliada" />
      <p id="modal-caption" class="modal-caption"></p>
    </div>
  </dialog>

  <!-- Floating WhatsApp Button -->
  <a
    href={site.whatsappUrl}
    class="floating-whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Fale com a MAP GLASS pelo WhatsApp"
  >
    <img
      src={asset(site.assets.whatsapp)}
      alt="WhatsApp MAP GLASS"
      width="60"
      height="60"
      loading="lazy"
    />
  </a>
</BaseLayout>
