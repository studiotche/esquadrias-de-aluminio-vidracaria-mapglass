---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, solutions, projects, trustItems } from "../data/site";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout>
  <a class="skip-link" href="#inicio">Ir para o conteúdo principal</a>

  <!-- Header -->
  <header class="header">
    <div class="container header-container">
      <a href="#inicio" class="logo-link" aria-label="AlumiArt Ijuí - Início">
        <img
          src={asset(site.assets.logo)}
          alt="AlumiArt Ijuí"
          class="logo"
          width="180"
          height="56"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav class="main-nav" aria-label="Navegação principal">
        <ul class="nav-list">
          <li><a href="#inicio" class="nav-link active">Início</a></li>
          <li><a href="#solucoes" class="nav-link">Soluções</a></li>
          <li><a href="#projetos" class="nav-link">Projetos</a></li>
          <li><a href="#sobre" class="nav-link">Sobre</a></li>
        </ul>
      </nav>

      <a
        href={site.whatsappUrl}
        class="btn btn-primary header-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar orçamento pelo WhatsApp"
      >
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
        <span>Solicitar orçamento</span>
      </a>

      <button
        class="mobile-menu-toggle"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        type="button"
      >
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section id="inicio" class="hero" aria-labelledby="hero-heading">
      <div class="hero-bg">
        <img
          src={asset(site.assets.hero)}
          alt="Fachada com esquadrias de alumínio e portas de vidro"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-overlay" aria-hidden="true"></div>
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <span class="eyebrow">ESQUADRIAS EM ALUMÍNIO &bull; IJUÍ / RS</span>
          <h1 id="hero-heading">
            Design que valoriza.<br />Qualidade que<br />permanece.
          </h1>
          <p>
            Esquadrias sob medida para transformar seu projeto em um lugar especial.
          </p>
          <div class="hero-actions">
            <a
              href={site.whatsappUrl}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
              <span>Solicitar meu orçamento</span>
            </a>
            <a href="#solucoes" class="link-with-arrow">
              <span>Conheça nossas soluções</span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
        <div class="hero-caption">
          <p>Alumínio, vidro e novas possibilidades.</p>
        </div>
      </div>
    </section>

    <!-- Trust Banner -->
    <section class="trust-banner" aria-label="Diferenciais da AlumiArt">
      <div class="container trust-container">
        {
          trustItems.map((item, index) => (
            <>
              <div class="trust-item">
                <i class={item.icon} aria-hidden="true"></i>
                <div class="trust-text">
                  <strong>{item.title}</strong>
                  <p>{item.description}</p>
                </div>
              </div>
              {index < trustItems.length - 1 && <div class="trust-divider" aria-hidden="true"></div>}
            </>
          ))
        }
      </div>
    </section>

    <!-- Solutions Section -->
    <section id="solucoes" class="solutions" aria-labelledby="solutions-heading">
      <div class="container">
        <div class="solutions-header">
          <div class="solutions-title-group">
            <span class="eyebrow">NOSSAS SOLUÇÕES</span>
            <h2 id="solutions-heading">
              Cada detalhe faz parte<br />do seu projeto.
            </h2>
          </div>
          <div class="solutions-desc">
            <p>
              Funcionalidade e estética em soluções<br />para diferentes ambientes.
            </p>
          </div>
        </div>

        <div class="solutions-grid">
          {
            solutions.map((item) => (
              <article class="solution-card">
                <div class="solution-image-wrapper">
                  <img
                    src={asset(item.image)}
                    alt={item.alt}
                    class={`solution-image ${item.imgClass}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <h3 class="solution-title">{item.title}</h3>
                <a
                  href={item.link}
                  class="solution-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Saiba mais sobre ${item.title} no WhatsApp`}
                >
                  <span>Saiba mais</span>
                  <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projetos" class="projects" aria-labelledby="projects-heading">
      <div class="container">
        <div class="projects-header">
          <div class="projects-title-group">
            <span class="eyebrow">INSPIRAÇÃO EM CADA ENTREGA</span>
            <h2 id="projects-heading">
              Seu próximo projeto<br />começa com uma boa referência.
            </h2>
          </div>
          <a href="#projetos" class="link-with-arrow projects-link">
            <span>Ver projetos</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="projects-grid">
          {
            projects.map((project) => (
              <button
                class={`project-card ${project.isLarge ? "card-large" : "card-small"}`}
                type="button"
                aria-label={`Ampliar imagem ${project.title}`}
                data-image={asset(project.image)}
                data-caption={project.title}
              >
                <img
                  src={asset(project.image)}
                  alt={project.alt}
                  class="project-image"
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-caption-overlay">
                  <span class="project-caption">{project.title}</span>
                </div>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="sobre" class="about" aria-labelledby="about-heading">
      <div class="container about-container">
        <div class="about-image-wrapper">
          <img
            src={asset(site.assets.about)}
            alt="Detalhe de perfil de alumínio e maçaneta com acabamento preciso"
            class="about-image"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about-content">
          <span class="eyebrow">SOBRE A ALUMIART</span>
          <h2 id="about-heading">
            Precisão no detalhe.<br />Cuidado em cada projeto.
          </h2>
          <p>
            Há 15 anos, a AlumiArt une qualidade, elegância e modernidade em projetos residenciais e comerciais.
          </p>
          <a
            href={site.instagramUrl}
            class="link-with-arrow about-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Conheça a AlumiArt no Instagram"
          >
            <span>Conheça a AlumiArt</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" aria-labelledby="cta-heading">
      <div class="container cta-container">
        <h2 id="cta-heading" class="cta-title">
          Vamos dar forma<br />ao seu projeto?
        </h2>
        <div class="cta-divider" aria-hidden="true"></div>
        <p class="cta-text">
          Converse com nossa equipe<br />e solicite seu orçamento.
        </p>
        <a
          href={site.whatsappUrl}
          class="btn btn-primary cta-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <span>Falar no WhatsApp</span>
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <!-- Coluna 1: Marca -->
        <div class="footer-brand">
          <img
            src={asset(site.assets.logoWhite)}
            alt="AlumiArt Ijuí"
            class="footer-logo"
            loading="lazy"
            decoding="async"
            width="180"
            height="72"
          />
          <p class="footer-desc">
            Esquadrias sob medida.<br />Qualidade, elegância e modernidade.
          </p>
          <h3 class="footer-title">ACOMPANHE NOSSOS PROJETOS</h3>
          <div class="footer-social">
            <div class="social-buttons">
              <a
                href={site.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram da AlumiArt"
                class="social-btn"
              >
                <i class="fa-brands fa-instagram" aria-hidden="true"></i>
              </a>
              <a
                href={site.facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook da AlumiArt"
                class="social-btn"
              >
                <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
              </a>
            </div>
            <a
              href={site.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="social-handle"
            >
              {site.instagramHandle}
            </a>
          </div>
        </div>

        <!-- Coluna 2: Navegação -->
        <div class="footer-nav">
          <h3 class="footer-title">NAVEGUE</h3>
          <ul class="footer-links">
            <li><a href="#inicio">Início</a></li>
            <li><a href="#solucoes">Soluções</a></li>
            <li><a href="#projetos">Projetos</a></li>
            <li><a href="#sobre">Sobre a AlumiArt</a></li>
          </ul>
        </div>

        <!-- Coluna 3: Contato -->
        <div class="footer-contact">
          <h3 class="footer-title">VAMOS CONVERSAR</h3>
          <a
            href={site.whatsappUrl}
            class="footer-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Conversar no WhatsApp ${site.phoneDisplay}`}
          >
            <i class="ph ph-whatsapp-logo" aria-hidden="true"></i>
            <span>{site.phoneDisplay}</span>
          </a>
          <p class="footer-contact-desc">Conte sua ideia para nossa equipe.</p>
          <a
            href={site.whatsappUrl}
            class="btn footer-cta-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Solicitar orçamento</span>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <div class="footer-location">
            <i class="ph ph-map-pin" aria-hidden="true"></i>
            <span>{site.locationDisplay}</span>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; AlumiArt. Todos os direitos reservados.</p>
        <div class="footer-bottom-links">
          <a href="#" class="privacy-link">Política de privacidade</a>
          <span class="footer-bottom-divider" aria-hidden="true">|</span>
          <a href="#inicio" class="back-to-top">
            <span>Voltar ao topo</span>
            <i class="ph ph-arrow-up" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Modal Lightbox -->
  <dialog id="image-modal" class="image-modal" aria-label="Visualizador de imagem">
    <button class="modal-close" aria-label="Fechar visualizador" type="button" autofocus>
      <i class="ph ph-x" aria-hidden="true"></i>
    </button>
    <div class="modal-content">
      <img id="modal-img" src="" alt="Imagem ampliada" />
      <p id="modal-caption" class="modal-caption"></p>
    </div>
  </dialog>
</BaseLayout>
